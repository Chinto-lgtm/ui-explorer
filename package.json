{
  "name": "ui-explorer",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "An open-source interactive laboratory for exploring and experimenting with interface design systems.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:data": "vite-node scripts/export-engine-data.ts",
    "engine:test": "python -m unittest discover -s tools/style-engine/tests -t tools/style-engine",
    "registry:check": "cd tools/style-engine && python -m style_engine registry ../../styles/community/index.json",
    "registry:previews": "vite-node scripts/build-community-previews.ts",
    "style:package": "vite-node scripts/make-style-package.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
