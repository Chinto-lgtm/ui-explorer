{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Explorer Style Definition Schema",
  "type": "object",
  "required": ["id", "name", "tokens"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": ["Morphism", "Modern", "Expressive", "Futuristic", "Retro", "Minimalist", "Custom", "Community"]
    },
    "metadata": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "personality": { "type": "string" },
        "license": { "type": "string" },
        "repository": { "type": "string" }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["colors", "typography", "radii", "shadows", "borders", "motion"],
      "properties": {
        "colors": { "type": "object" },
        "typography": { "type": "object" },
        "radii": { "type": "object" },
        "shadows": { "type": "object" },
        "borders": { "type": "object" },
        "motion": { "type": "object" }
      }
    }
  }
}
